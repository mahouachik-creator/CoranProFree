{
  "expo": {
    "name": "Quran Pro Audio",
    "slug": "quran-pro-audio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quran-pro-audio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", ["expo-audio", { "enableBackgroundPlayback": true }]],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
